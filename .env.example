# Copy to .env (never commit .env)
JWT_SECRET=change-me-to-a-long-random-string
ADMIN_TOKEN_HOURS=12
CORS_ORIGINS=http://localhost:3000
# Used once by `python -m app.seed` to create the first Owner login
SEED_OWNER_NAME=Owner
SEED_OWNER_MOBILE=9000000001
SEED_OWNER_PIN=246810
# App notifications: console prints them in the worker log; expo sends to phones
PUSH_PROVIDER=console
# EXPO_ACCESS_TOKEN=   # only if enhanced push security is on in the Expo account
